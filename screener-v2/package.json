{
  "name": "innobot-premium-screener-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-next.mjs && node scripts/ensure-prisma-client.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:db": "node scripts/require-test-db-env.mjs && node scripts/run-db-tests.mjs",
    "test:all": "npm run test && npm run test:db",
    "clean": "node scripts/clean-next.mjs",
    "validate:questions": "node scripts/validate-question-bank.mjs",
    "addons:sync": "node scripts/sync-addon-catalog.mjs",
    "addon-presets:sync": "node scripts/sync-addon-presets.mjs",
    "addons:bootstrap": "npm run addons:sync && npm run addon-presets:sync",
    "addon:scaffold": "node scripts/scaffold-addon.mjs",
    "format:scaffold": "node scripts/scaffold-format.mjs",
    "postinstall": "node scripts/postinstall-prisma.mjs",
    "bootstrap:access": "npx tsx scripts/bootstrap-access.ts",
    "setup:admin-innobot": "npx tsx scripts/setup-admin-innobot.ts",
    "import:all-designations": "npx tsx scripts/import-all-designations.ts",
    "import:designations": "npx tsx scripts/import-designations.ts",
    "import:candidates:dry-run": "npx tsx scripts/candidate-import-dry-run.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "vercel-build": "npm run prisma:migrate:deploy && npm run build",
    "deploy:preview": "npx vercel --cwd .. --yes",
    "deploy:prod": "npx vercel --cwd .. --prod --yes"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.4.49",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "xlsx": "^0.18.5"
  }
}
