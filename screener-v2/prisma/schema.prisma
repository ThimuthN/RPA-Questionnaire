generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AttemptStatus {
  in_progress
  submitted
  graded
  reviewed
}

enum ResultReviewState {
  unreviewed
  reviewed
  flagged
}

enum CandidateMilestoneStatus {
  not_started
  in_progress
  done
  failed
  skipped
}

enum CandidateOfferStatus {
  draft
  submitted_for_approval
  approved
  sent
  accepted
  rejected
  expired
}

enum HiringTeamRole {
  owner
  recruiter
  hiring_manager
  interviewer
  reviewer
  final_approver
}

enum DepartmentCandidacyTeamAssignmentSource {
  template
  job_default
  manual
}

model Department {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles     RoleCatalog[]
  users     User[]
  candidates Candidate[]
  employees Employee[]
  jobPostings JobPosting[]
  departmentCandidacies DepartmentCandidacy[]
  accessGrants AccessGrant[]
  hiringTeamTemplates HiringTeamTemplate[]
  assessmentPresets AssessmentPreset[]
  integrationConnections DepartmentIntegrationConnection[]
  candidateEmailThreads CandidateEmailThread[]
  interviewKits InterviewKit[]
  offerApprovalChains OfferApprovalChain[]
  dataRetentionPolicies DataRetentionPolicy[]

  @@index([isActive, sortOrder])
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  name                    String?
  departmentId            String?
  roleId                  String?
  passwordHash            String?
  isActive                Boolean               @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  dept                    Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role                    RoleCatalog?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  ownedCandidates         Candidate[]           @relation("HROwner")
  interviewPanels         InterviewPanelMember[]
  interviewFeedbacks      InterviewFeedback[]
  permissionOverrides     UserPermissionOverride[]
  hiringAssignments       HiringAssignment[]    @relation("HiringAssignments")
  assignedHiringAssignments HiringAssignment[]  @relation("HiringAssignmentsCreatedBy")
  accessGrants            AccessGrant[]
  hiringTeamTemplateMemberships HiringTeamTemplateMember[]
  candidacyTeamAssignments      DepartmentCandidacyTeamAssignment[]
  addedCandidacyTeamAssignments DepartmentCandidacyTeamAssignment[] @relation("AddedByTeam")
  sentEmails                    EmailLog[]
  createdInterviewKits          InterviewKit[] @relation("InterviewKitCreatedBy")
  offerApprovalChainSteps       OfferApprovalChainStep[] @relation("OfferApprovalChainStepApprover")
  offerApprovalSteps            OfferApprovalStep[] @relation("OfferApprovalStepApprover")
  notifications                 AppNotification[]

  @@index([departmentId])
  @@index([roleId])
}

model AssessmentTemplate {
  id          String   @id @default(cuid())
  title       String
  status      String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssessmentVersion {
  id               String   @id @default(cuid())
  templateId       String
  versionNumber    Int
  blueprintJson    Json
  questionBankRef  String
  practicalPackRef String
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model AddonCatalog {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  label                 String
  description           String
  assessmentTypeId      String   @map("engineType")
  defaultConfigJson     Json
  defaultDurationMinutes Int
  defaultRequiredPercent Int
  defaultWeight         Int
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  presetItems           AssessmentPresetItem[]

  @@index([isActive, sortOrder])
}

model AssessmentPreset {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String
  departmentId String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  items       AssessmentPresetItem[]
  jobPostings JobPosting[]

  @@index([isActive, sortOrder])
  @@index([departmentId, isActive, sortOrder])
}

model AssessmentPresetItem {
  id                 String   @id @default(cuid())
  presetId           String
  addonId            String
  sortOrder          Int
  configOverrideJson Json?
  weightOverride     Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  preset             AssessmentPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  addon              AddonCatalog     @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([presetId, sortOrder])
  @@index([addonId])
}

model Invite {
  id                  String   @id @default(cuid())
  assessmentVersionId String
  mode                String
  contextType         String   @default("general")
  slug                String   @unique
  tokenHash           String   @unique
  passcodeHash        String?
  integrityPreset     String?
  roleLocked          Boolean  @default(true)
  stackLocked         Boolean  @default(true)
  roleId              String?
  passTargetPercent   Int?
  stacksJson          Json?
  sectionsJson        Json?
  blueprintJson       Json?
  maxAttempts         Int      @default(1)
  usedAttempts        Int      @default(0)
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  attempts            Attempt[]
  candidateAssessments CandidateAssessment[]

  @@index([assessmentVersionId])
}

model RoleCatalog {
  id                      String                      @id @default(cuid())
  slug                    String                      @unique
  label                   String
  kind                    String                      @default("job_designation")
  applicability           String?                     @default("department")
  department              String?
  departmentId            String
  description             String?
  experienceLevel         String?
  requirements            String?
  sortOrder               Int                         @default(0)
  isActive                Boolean                     @default(true)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  dept                    Department                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  candidates              Candidate[]
  employees               Employee[]
  jobPostings             JobPosting[]
  departmentCandidacies   DepartmentCandidacy[]
  users                   User[]
  permissions             RolePermissionTemplate[]
  accessGrants            AccessGrant[]

  @@index([isActive, sortOrder])
  @@index([label, department])
  @@index([departmentId])
}

model RolePermissionTemplate {
  id        String   @id @default(cuid())
  roleId    String
  role      RoleCatalog @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  scope     String   @default("own_dept")
  createdAt DateTime @default(now())

  @@unique([roleId, permission])
  @@index([roleId])
}

model AccessGrant {
  id            String   @id @default(cuid())
  userId        String
  roleId        String
  scope         String
  departmentId  String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          RoleCatalog @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@index([scope, status])
  @@index([userId, scope, status])
  @@index([userId, departmentId])
}

model UserPermissionOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  action    String
  grantedBy String
  reason    String?
  grantedAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

model Participant {
  id         String   @id @default(cuid())
  kind       String
  fullName   String
  email      String
  phone      String?
  employeeId String?
  createdAt  DateTime @default(now())
  attempts   Attempt[]

  @@unique([kind, email])
}

model Attempt {
  id                     String         @id @default(cuid())
  assessmentVersionId    String
  inviteId               String?
  participantId          String
  contextType            String         @default("general")
  integrityPreset        String?
  roleId                 String?
  passTargetPercent      Int
  stacksJson             Json
  sectionsJson           Json
  blueprintJson          Json?
  sectionStateJson       Json?
  seed                   Int
  stage                  String
  status                 AttemptStatus
  coreQuestionIdsJson    Json
  coreAnswersJson        Json
  practicalAnswerJson    Json
  practicalEarned        Float          @default(0)
  practicalPossible      Float          @default(0)
  logicReasoningAnswerJson Json?
  logicReasoningEarned   Float          @default(0)
  logicReasoningPossible Float          @default(0)
  remainingCoreSeconds   Int
  remainingPracticalSeconds Int
  remainingLogicReasoningSeconds Int?
  stateVersion           Int            @default(0)
  integrityJson          Json
  startedAt              DateTime       @default(now())
  submittedAt            DateTime?
  invite                 Invite?        @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  participant            Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  result                 Result?
  candidateAssessment    CandidateAssessment?
  candidateAssessmentAttempts CandidateAssessmentAttempt[]
  applicationScreening  CandidateApplication? @relation("CandidateApplicationScreeningAttempt")

  @@index([inviteId])
  @@index([participantId])
  @@index([status, startedAt])
}

model Result {
  id               String              @id @default(cuid())
  attemptId        String              @unique
  contextType      String              @default("general")
  reviewState      ResultReviewState   @default(unreviewed)
  corePercent      Float
  practicalPercent Float
  finalPercent     Float
  pass             Boolean
  borderline       Boolean
  breakdownJson    Json
  exportedAt       DateTime?
  createdAt        DateTime            @default(now())
  attempt          Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([finalPercent])
  @@index([reviewState, createdAt])
  @@index([contextType, reviewState, createdAt])
}

model MagicToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Candidate {
  id                 String   @id @default(cuid())
  fullName           String
  email              String   @unique
  phone              String?
  roleId             String?
  departmentId       String?
  hrOwnerId          String?
  positionAppliedFor String?
  batchId            String?
  resumeSource       String?
  hrOwner            String?
  stage              String   @default("pipeline")
  nextAction         String   @default("none")
  screeningStatus    String?
  candidateFolderUrl String?
  notesSummary       String?
  linkedInUrl        String?
  location           String?
  currentTitle       String?
  salaryExpectation  String?
  orgStatus          String   @default("active")
  orgStage           String   @default("active")
  finalizedAs        String?
  searchVector       Unsupported("tsvector")?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  role               RoleCatalog? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hrOwnerUser        User? @relation("HROwner", fields: [hrOwnerId], references: [id], onDelete: SetNull)
  resumes            CandidateResume[]
  attachments        CandidateAttachment[]
  assessments        CandidateAssessment[]
  externalAssessments CandidateExternalAssessment[]
  notes              CandidateNote[]
  milestones         CandidateMilestone[]
  applications       CandidateApplication[]
  activityEvents     CandidateActivityEvent[]
  interviewPanels    InterviewPanel[]
  offer              CandidateOffer?
  employee           Employee?
  departmentCandidacies DepartmentCandidacy[]
  emailLogs          EmailLog[]
  emailThreads       CandidateEmailThread[]
  emailMessages      CandidateEmailMessage[]
  @@index([roleId])
  @@index([departmentId])
  @@index([hrOwnerId])
  @@index([stage, updatedAt])
  @@index([stage, departmentId, orgStage])
  @@index([fullName])
  @@index(fields: [searchVector], type: Gin, map: "candidate_fts_idx")
}

model DepartmentCandidacy {
  id             String   @id @default(cuid())
  candidateId    String
  departmentId   String
  roleId         String?
  hrOwnerId      String?
  status         String   @default("active")
  source         String   @default("manual")
  nominatedBy    String?
  nominationNote String?
  jobPostingId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidate         Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  department        Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role              RoleCatalog? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamAssignments   DepartmentCandidacyTeamAssignment[]

  @@unique([candidateId, departmentId])
  @@index([departmentId, status, updatedAt])
  @@index([candidateId])
  @@index([hrOwnerId])
  @@index([jobPostingId])
}

model CandidateResume {
  id         String   @id @default(cuid())
  candidateId String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  storageUrl String
  uploadedAt DateTime @default(now())
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, storageKey])
  @@index([candidateId, uploadedAt])
}

model CandidateAttachment {
  id          String   @id @default(cuid())
  candidateId String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  storageUrl  String
  label       String?
  uploadedAt  DateTime @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, storageKey])
  @@index([candidateId, uploadedAt])
}

model CandidateAssessment {
  id          String   @id @default(cuid())
  candidateId String
  inviteId    String   @unique
  attemptId   String?  @unique
  createdAt   DateTime @default(now())
  createdById String?
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  invite      Invite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  attempt     Attempt?  @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  attemptHistory CandidateAssessmentAttempt[]
  milestones  CandidateMilestone[]

  @@index([candidateId, createdAt])
}

model CandidateAssessmentAttempt {
  id                  String   @id @default(cuid())
  candidateAssessmentId String
  attemptId           String   @unique
  linkedAt            DateTime @default(now())
  candidateAssessment CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)
  attempt             Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([candidateAssessmentId, attemptId])
  @@index([candidateAssessmentId, linkedAt])
}

model CandidateExternalAssessment {
  id            String   @id @default(cuid())
  candidateId    String
  title         String
  sourceLabel   String?
  status        String   @default("completed")
  scorePercent  Float?
  scoreLabel    String?
  summary       String?
  completedAt   DateTime?
  recordedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attachments   CandidateExternalAssessmentAttachment[]

  @@index([candidateId, createdAt])
  @@index([candidateId, completedAt])
}

model CandidateExternalAssessmentAttachment {
  id                   String   @id @default(cuid())
  externalAssessmentId String
  fileName             String
  mimeType             String
  sizeBytes            Int
  storageKey           String
  storageUrl           String
  uploadedById         String?
  uploadedAt           DateTime @default(now())
  externalAssessment   CandidateExternalAssessment @relation(fields: [externalAssessmentId], references: [id], onDelete: Cascade)

  @@unique([externalAssessmentId, storageKey])
  @@index([externalAssessmentId, uploadedAt])
}

model CandidateNote {
  id          String   @id @default(cuid())
  candidateId String
  type        String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model CandidateMilestone {
  id                   String                    @id @default(cuid())
  candidateId          String
  type                 String
  title                String
  status               CandidateMilestoneStatus
  sortOrder            Int
  mode                 String
  date                 DateTime?
  notes                String?
  score                Float?
  result               String?
  recommendation       String?
  candidateAssessmentId String?                  @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  candidate            Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateAssessment  CandidateAssessment?      @relation(fields: [candidateAssessmentId], references: [id], onDelete: SetNull)
  checks               CandidateMilestoneCheck[]
  interviewPanel       InterviewPanel?

  @@unique([candidateId, sortOrder])
  @@index([candidateId, sortOrder])
}

model CandidateMilestoneCheck {
  id          String   @id @default(cuid())
  milestoneId String
  type        String
  status      String
  notes       String?
  actorId     String?
  actorName   String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  milestone   CandidateMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, type])
  @@index([milestoneId])
}

model CandidateActivityEvent {
  id         String   @id @default(cuid())
  candidateId String
  actorId    String?
  actorName  String?
  event      String
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@index([candidateId, event, createdAt])
}

model JobPosting {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  roleId      String?
  departmentId String?
  screenerPresetId String?
  summary     String
  description String
  salaryMin   Int?
  salaryMax   Int?
  teamSize    Int?
  techStack   String?
  remotePolicy String?
  isPublished Boolean  @default(false)
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        RoleCatalog? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  screenerPreset AssessmentPreset? @relation(fields: [screenerPresetId], references: [id], onDelete: SetNull)
  applications CandidateApplication[]
  interviewKits JobPostingInterviewKit[]
  offerApprovalChains OfferApprovalChain[]

  @@index([roleId])
  @@index([departmentId])
  @@index([screenerPresetId])
  @@index([isPublished, isOpen, updatedAt])
}

model CandidateApplication {
  id              String   @id @default(cuid())
  candidateId     String
  jobPostingId    String
  screeningAttemptId String? @unique
  status          String
  source          String?
  referredBy      String?
  coverNote       String?
  consentGivenAt  DateTime?
  consentVersion  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  screeningAttempt Attempt? @relation("CandidateApplicationScreeningAttempt", fields: [screeningAttemptId], references: [id], onDelete: SetNull)
  assignments  HiringAssignment[]
  screeningAddonResults CandidateApplicationAddonResult[]
  responses    CandidateApplicationResponse[]

  @@unique([candidateId, jobPostingId])
  @@index([candidateId, createdAt])
  @@index([jobPostingId, status, createdAt])
  @@index([screeningAttemptId])
}

model CandidateApplicationAddonResult {
  id               String   @id @default(cuid())
  applicationId    String
  presetId         String?
  presetLabel      String
  addonId          String?
  addonSlug        String
  addonLabel       String
  assessmentTypeId String
  requiredPercent  Int
  weight           Int
  isMandatory      Boolean  @default(true)
  inlineSupported  Boolean  @default(true)
  status           String
  applicantPercent Float?
  pointsEarned     Float    @default(0)
  pointsPossible   Float    @default(0)
  sortOrder        Int
  createdAt        DateTime @default(now())
  application      CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  responses        CandidateApplicationResponse[]

  @@index([applicationId, sortOrder])
}

model CandidateApplicationResponse {
  id            String   @id @default(cuid())
  applicationId String
  addonResultId String
  questionKey   String
  questionLabel String
  formatLabel   String
  answerJson    Json
  answerText    String?
  pointsEarned  Float    @default(0)
  pointsPossible Float   @default(0)
  sortOrder     Int
  createdAt     DateTime @default(now())
  application   CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  addonResult   CandidateApplicationAddonResult @relation(fields: [addonResultId], references: [id], onDelete: Cascade)

  @@index([applicationId, sortOrder])
  @@index([addonResultId, sortOrder])
}

enum HiringAssignmentRole {
  recruiter
  hiring_manager
  interviewer
  reviewer
  coordinator
  approver
}

model HiringAssignment {
  id              String                  @id @default(cuid())
  applicationId   String
  userId          String
  assignmentRole  HiringAssignmentRole
  isPrimary       Boolean                 @default(false)
  active          Boolean                 @default(true)
  assignedAt      DateTime                @default(now())
  assignedById    String?
  dueAt           DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  application     CandidateApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user            User                    @relation("HiringAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy      User?                   @relation("HiringAssignmentsCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, userId, assignmentRole, active])
  @@index([applicationId, active])
  @@index([applicationId, assignmentRole, active])
  @@index([userId, active])
  @@index([active])
}

model Employee {
  id               String    @id @default(cuid())
  candidateId      String?   @unique
  employeeNumber   String    @unique
  fullName         String
  email            String    @unique
  phone            String?
  title            String?
  roleId           String?
  departmentId     String?
  managerId        String?
  employmentType   String    @default("full_time")
  employmentStatus String    @default("active")
  startDate        DateTime
  probationEndDate DateTime?
  endDate          DateTime?
  location         String?
  level            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  candidate        Candidate?  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  role             RoleCatalog? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager          Employee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]  @relation("EmployeeManager")
  activityEvents   EmployeeActivityEvent[]
  goals            EmployeeGoal[]
  reviews          PerformanceReview[]

  @@index([departmentId, employmentStatus])
  @@index([managerId])
  @@index([roleId])
  @@index([employmentStatus, startDate])
}

model EmployeeActivityEvent {
  id         String   @id @default(cuid())
  employeeId String
  actorId    String?
  actorName  String?
  event      String
  detail     String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
}

model EmployeeGoal {
  id          String      @id @default(cuid())
  employeeId  String
  title       String
  description String?
  category    String      @default("performance")
  status      String      @default("active")
  targetDate  DateTime?
  progress    Int         @default(0)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkIns    GoalCheckIn[]

  @@index([employeeId, status])
  @@index([employeeId, targetDate])
}

model GoalCheckIn {
  id               String      @id @default(cuid())
  goalId           String
  notes            String
  progressSnapshot Int
  createdById      String?
  createdAt        DateTime    @default(now())
  goal             EmployeeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model PerformanceReview {
  id                      String    @id @default(cuid())
  employeeId              String
  reviewerId              String
  period                  String
  type                    String    @default("annual")
  status                  String    @default("draft")
  overallRating           Int?
  strengths               String?
  improvements            String?
  nextPeriodFocus         String?
  employeeAcknowledgedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  employee                Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([reviewerId, status])
}

model CandidateOffer {
  id                 String                @id @default(cuid())
  candidateId        String                @unique
  status             CandidateOfferStatus  @default(draft)
  compensationType   String                @default("salary")
  compensationAmount Int?
  currency           String                @default("USD")
  targetStartDate    DateTime?
  expiresAt          DateTime?
  offerNotes         String?
  sentAt             DateTime?
  respondedAt        DateTime?
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  candidate          Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  approvalSteps      OfferApprovalStep[]

  @@index([status, updatedAt])
  @@index([candidateId])
}

model OfferApprovalChain {
  id           String   @id @default(cuid())
  departmentId String?
  jobPostingId String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  steps        OfferApprovalChainStep[]

  @@index([departmentId])
  @@index([jobPostingId])
}

model OfferApprovalChainStep {
  id         String   @id @default(cuid())
  chainId    String
  approverId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  chain      OfferApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  approver   User     @relation("OfferApprovalChainStepApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([chainId, sortOrder])
}

model OfferApprovalStep {
  id         String    @id @default(cuid())
  offerId    String
  approverId String
  sortOrder  Int       @default(0)
  status     String    @default("pending")
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  offer      CandidateOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  approver   User      @relation("OfferApprovalStepApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([offerId, sortOrder])
  @@index([approverId, status])
}

model InterviewPanel {
  id          String   @id @default(cuid())
  candidateId String
  milestoneId String?  @unique
  roundNumber Int
  roundName   String
  format      String   @default("in_person")
  scheduledAt DateTime?
  durationMin Int      @default(60)
  status      String   @default("scheduled")
  meetingUrl  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidate   Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  milestone   CandidateMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  members             InterviewPanelMember[]
  feedbacks           InterviewFeedback[]
  eventSync           InterviewEventSync?
  schedulingTokens    SchedulingToken[]
  availabilityWindows AvailabilityWindow[]

  @@index([candidateId, roundNumber])
  @@index([status, scheduledAt])
}

model InterviewPanelMember {
  id        String         @id @default(cuid())
  panelId   String
  userId    String
  role      String         @default("interviewer")
  createdAt DateTime       @default(now())
  panel     InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([panelId, userId])
  @@index([panelId])
  @@index([userId])
}

model InterviewFeedback {
  id                String         @id @default(cuid())
  panelId           String
  interviewerId     String
  overallRating     Int?
  recommendation    String?
  competencyJson    Json?
  strengths         String?
  concerns          String?
  privateNotes      String?
  submittedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  panel             InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  interviewer       User           @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([panelId, interviewerId])
  @@index([panelId])
  @@index([panelId, submittedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorEmail String?
  targetId   String
  targetType String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetId, targetType])
  @@index([actorId])
  @@index([createdAt])
}

model HiringTeamTemplate {
  id              String   @id @default(cuid())
  departmentId    String
  name            String
  description     String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members         HiringTeamTemplateMember[]

  @@index([departmentId, isActive, sortOrder])
}

model HiringTeamTemplateMember {
  id                String   @id @default(cuid())
  templateId        String
  userId            String
  role              HiringTeamRole

  template          HiringTeamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId, role])
  @@index([templateId])
  @@index([userId])
}

model DepartmentCandidacyTeamAssignment {
  id              String   @id @default(cuid())
  candidacyId     String
  userId          String
  role            HiringTeamRole
  source          DepartmentCandidacyTeamAssignmentSource @default(manual)
  templateId      String?
  isPrimary       Boolean  @default(false)
  isActive        Boolean  @default(true)
  addedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt
  addedById       String?

  candidacy       DepartmentCandidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy         User?               @relation("AddedByTeam", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([candidacyId, userId, role])
  @@index([candidacyId])
  @@index([userId])
  @@index([isActive])
}

model EmailLog {
  id           String    @id @default(cuid())
  to           String
  cc           String?
  subject      String
  template     String
  candidateId  String?
  sentById     String?
  status       String    @default("sent")
  errorMsg     String?
  sentAt       DateTime  @default(now())
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  sentBy       User?      @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([candidateId, sentAt])
  @@index([status])
  @@index([status, sentAt])
}

model IntegrationProviderApp {
  id                    String   @id @default(cuid())
  provider              String   @unique
  clientId              String?
  clientSecretEncrypted String?
  tenantId              String?
  scopesJson            Json?
  configJson            Json?
  enabled               Boolean  @default(false)
  lastHealthStatus      String   @default("not_configured")
  lastHealthError       String?
  lastCheckedAt         DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DepartmentIntegrationConnection {
  id                    String   @id @default(cuid())
  departmentId          String
  provider              String
  status                String   @default("not_connected")
  connectedAccountId    String?
  connectedAccountLabel String?
  connectedTenantId     String?
  scopesJson            Json?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  lastSuccessAt         DateTime?
  lastError             String?
  lastCheckedAt         DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  department            Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  resources             DepartmentIntegrationResource[]
  webhookSubscriptions  IntegrationWebhookSubscription[]
  syncCursors           IntegrationSyncCursor[]
  interviewEventSyncs   InterviewEventSync[]

  @@unique([departmentId, provider])
  @@index([departmentId, status])
}

model DepartmentIntegrationResource {
  id                String   @id @default(cuid())
  connectionId      String
  resourceType      String
  externalResourceId String
  displayLabel      String
  emailAddress      String?
  isDefault         Boolean  @default(false)
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  connection        DepartmentIntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resourceType, externalResourceId])
  @@index([connectionId, resourceType, isDefault])
}

model IntegrationWebhookSubscription {
  id                     String   @id @default(cuid())
  provider               String
  connectionId           String?
  resourceTarget         String
  externalSubscriptionId String
  expiresAt              DateTime?
  status                 String   @default("inactive")
  lastRenewedAt          DateTime?
  lastError              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  connection             DepartmentIntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSubscriptionId])
  @@index([connectionId, status])
}

model IntegrationSyncCursor {
  id           String   @id @default(cuid())
  connectionId String
  domain       String
  cursorValue  String?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  connection   DepartmentIntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, domain])
}

model CandidateEmailThread {
  id               String   @id @default(cuid())
  candidateId      String
  departmentId     String
  provider         String
  externalThreadId String
  subject          String
  lastMessageAt    DateTime
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  messages         CandidateEmailMessage[]

  @@unique([provider, externalThreadId])
  @@index([candidateId, lastMessageAt])
  @@index([departmentId, lastMessageAt])
}

model CandidateEmailMessage {
  id             String   @id @default(cuid())
  threadId       String
  candidateId    String
  provider       String
  providerMessageId String
  direction      String
  sender         String
  recipientsJson Json
  bodyPreview    String?
  sanitizedHtml  String?
  sentAt         DateTime?
  receivedAt     DateTime?
  syncStatus     String   @default("synced")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  thread         CandidateEmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId])
  @@index([threadId, createdAt])
  @@index([candidateId, createdAt])
}

model InterviewEventSync {
  id                    String   @id @default(cuid())
  interviewPanelId      String   @unique
  connectionId          String
  provider              String
  externalCalendarEventId String
  externalMeetingId     String?
  joinUrl               String?
  organizerAccountId    String?
  lastSyncedAt          DateTime?
  lastSyncStatus        String   @default("pending")
  lastError             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  interviewPanel        InterviewPanel @relation(fields: [interviewPanelId], references: [id], onDelete: Cascade)
  connection            DepartmentIntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, provider])
}

model InterviewKit {
  id           String   @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  isGlobal     Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("InterviewKitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  competencies InterviewKitCompetency[]
  jobPostings  JobPostingInterviewKit[]

  @@index([departmentId])
  @@index([isGlobal])
}

model InterviewKitCompetency {
  id          String       @id @default(cuid())
  kitId       String
  name        String
  description String?
  anchors     Json         @default("{}")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  kit         InterviewKit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, sortOrder])
}

model JobPostingInterviewKit {
  id            String       @id @default(cuid())
  jobPostingId  String
  kitId         String
  milestoneType String       @default("interview")
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  jobPosting    JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  kit           InterviewKit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, kitId, milestoneType])
  @@index([jobPostingId])
  @@index([kitId])
}

model SchedulingToken {
  id          String    @id @default(cuid())
  token       String    @unique
  panelId     String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  panel       InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([panelId])
}

model AvailabilityWindow {
  id        String   @id @default(cuid())
  panelId   String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  panel     InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, startsAt])
}

model AppNotification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String?
  entityType  String?
  entityId    String?
  entityHref  String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model DataRetentionPolicy {
  id             String    @id @default(cuid())
  departmentId   String?
  retentionDays  Int
  actionOnExpiry String    @default("notify")
  appliesTo      String    @default("rejected_candidates")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}
