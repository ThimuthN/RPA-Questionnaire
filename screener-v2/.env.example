# ===== REQUIRED =====
# Database: Use pooled URL from Neon or RDS
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Database: Direct URL for Prisma migrations (no pooling)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require&connect_timeout=15"

# Application public URL (used for links, redirects, email templates)
APP_URL="https://hiring.company.com"

# Session encryption key. Must be 32+ random characters.
# Generate with: openssl rand -hex 16 or similar
AUTH_SESSION_SECRET="replace-with-long-random-string"

# ===== OPTIONAL: Vercel Blob Storage =====
# Only required if resume upload/storage uses Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ===== OPTIONAL: Redis Caching =====
# Only required if using Upstash Redis for sessions/cache
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ===== OPTIONAL: Branding =====
NEXT_PUBLIC_ORG_NAME="Your Company"
NEXT_PUBLIC_APP_URL="https://hiring.company.com"

# ===== BOOTSTRAP: Local development only =====
# Only used if no users exist in database
BOOTSTRAP_ADMIN_EMAIL="admin@company.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-password"
BOOTSTRAP_ADMIN_NAME="Admin"

# ===== OPTIONAL: Candidate import dry run =====
# Local operator-only dry run. Source is read-only; target is read-only in this batch.
IMPORT_SOURCE_DATABASE_URL="postgresql://user:password@source-host/source-db?sslmode=require"
IMPORT_TARGET_DATABASE_URL="postgresql://user:password@target-host/target-db?sslmode=require"
CANDIDATE_IMPORT_LIMIT="10"
